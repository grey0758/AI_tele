# ========================================
# AI Tele 应用配置示例
# ========================================
# 复制此文件为 .env 并根据需要修改配置值

# ========================================
# 应用基本配置
# ========================================
APP_NAME=AI Tele
DEBUG=false
LOG_LEVEL=INFO

# ========================================
# 数据库连接配置
# ========================================

# 方式1：本地SQLite数据库（最简单）
DATABASE_URL=sqlite:///./ai_tele.db

# 方式2：本地PostgreSQL数据库
# DATABASE_URL=postgresql://username:password@localhost:5432/ai_tele_db

# 方式3：远程PostgreSQL数据库
# DATABASE_URL=postgresql://username:password@your-server.com:5432/ai_tele_db

# ========================================
# SSH隧道配置
# ========================================
SSH_HOST=
SSH_PORT=22
SSH_USERNAME=
SSH_PASSWORD=
SSH_KEY_PATH=
SSH_REMOTE_HOST=localhost
SSH_REMOTE_PORT=3306
SSH_LOCAL_PORT=3307

# ========================================
# 数据库连接配置（SSH隧道）
# ========================================
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=
DB_USER=
DB_NAME2=
DB_NAME3=
SSH_USER=

# ========================================
# OpenAI API 配置
# ========================================
OPENAI_URL=
OPENAI_API_KEY=

# ========================================
# TTS 配置
# ========================================
TTS_APPID_C=
TTS_APIKEY_C=
TTS_APISECRET_C=

# ========================================
# RTASR 配置
# ========================================
RTASR_APPID=
RTASR_API_KEY=

# ========================================
# 安全配置
# ========================================
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# CORS配置
# ========================================
ALLOWED_ORIGINS=["http://localhost:3000"]

# ========================================
# 文件上传配置
# ========================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ========================================
# 服务器配置
# ========================================
HOST=0.0.0.0
PORT=8000

# ========================================
# Redis配置
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_DECODE_RESPONSES=true

# ========================================
# WebSocket配置
# ========================================
WEBSOCKET_PING_INTERVAL=20
WEBSOCKET_PING_TIMEOUT=5
WEBSOCKET_HEARTBEAT_INTERVAL=25
WEBSOCKET_CONNECTION_TIMEOUT=60
WEBSOCKET_MAX_RECONNECT_ATTEMPTS=5
WEBSOCKET_RECONNECT_DELAY=2
WEBSOCKET_MAX_RECONNECT_DELAY=60

# ========================================
# 事件总线配置
# ========================================
WORKER_COUNT=4
MAX_QUEUE_SIZE=1000
DEAD_LETTER_QUEUE_SIZE=100
DEFAULT_TIMEOUT=30.0
MAX_RETRY_COUNT=3
RETRY_DELAY=1.0
HEALTH_CHECK_INTERVAL=30
ENABLE_PERSISTENCE=true
PERSISTENCE_PATH=./logs/events

